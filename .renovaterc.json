{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>dargmuesli/renovate-config"
  ],
  "packageRules": [
    {
      "automerge": false,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ]
    }
  ],
  "semanticCommitType": "fix"
}
